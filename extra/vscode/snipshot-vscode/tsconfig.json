{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node20",
    "outDir": "out",
    "rootDir": ".",
    "strict": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "types": ["node", "mocha"]
  },
  "include": ["src/**/*", "test/**/*", "integration/**/*"],
  "exclude": ["node_modules", "out"]
}
